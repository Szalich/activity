#include <iostream>
using namespace std;

void count(int arr[], int &even, int &odd);
void sumEven(int arr[]);
void sumOdd(int arr[]);
void Max(int arr[]);
void Min(int arr[]);

int main()
{
    int arr[5];
    int even = 0, odd = 0;

    cout << "Enter 5 numbers: ";

    for(int i = 0; i < 5; i++)
    {
        cin >> arr[i];
    }

    count(arr, even, odd);

    cout << "Even numbers = " << even << endl;
    cout << "Odd numbers = " << odd << endl;

    sumEven(arr);
    sumOdd(arr);
    Max(arr);
    Min(arr);

    return 0;
}

void count(int arr[], int &even, int &odd)
{
    for(int i = 0; i < 5; i++)
    {
        if(arr[i] % 2 == 0)
            even++;
        else
            odd++;
    }
}

void sumEven(int arr[])
{
    int sum = 0;

    for(int i = 0; i < 5; i++)
    {
        if(arr[i] % 2 == 0)
            sum += arr[i];
    }

    cout << "Sum of even numbers = " << sum << endl;
}

void sumOdd(int arr[])
{
    int sum = 0;

    for(int i = 0; i < 5; i++)
    {
        if(arr[i] % 2 != 0)
            sum += arr[i];
    }

    cout << "Sum of odd numbers = " << sum << endl;
}

void Max(int arr[])
{
    int max = arr[0];

    for(int i = 1; i < 5; i++)
    {
        if(arr[i] > max)
            max = arr[i];
    }

    cout << "Maximum = " << max << endl;
}

void Min(int arr[])
{
    int min = arr[0];

    for(int i = 1; i < 5; i++)
    {
        if(arr[i] < min)
            min = arr[i];
    }

    cout << "Minimum = " << min << endl;
}
